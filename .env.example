# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Postgres (docker-compose "db" service)
POSTGRES_DB=smoi
POSTGRES_USER=smoi
POSTGRES_PASSWORD=change-me
DB_PORT=5432

# Backend
BACKEND_PORT=8080
# Base64-encoded HMAC key, at least 32 bytes. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=
# Access token lifetime as an ISO-8601 duration
JWT_TTL=PT1H
