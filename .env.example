# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Postgres (docker-compose "db" service)
POSTGRES_DB=smoi
POSTGRES_USER=smoi
POSTGRES_PASSWORD=change-me
DB_PORT=5432

# Backend
BACKEND_PORT=8080
# Base64-encoded HMAC key, at least 32 bytes. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=
# Access token lifetime as an ISO-8601 duration
JWT_TTL=PT1H

# SMOI Brain ingestion
# Embedding provider: "ollama" (local model). "hashing" is a test-only stand-in with no real meaning.
EMBEDDING_PROVIDER=ollama
# The compose "ollama" service. To use Ollama installed on Windows instead (for example with a GPU),
# set http://host.docker.internal:11434 and run `ollama pull nomic-embed-text` there.
OLLAMA_BASE_URL=http://ollama:11434
# Must produce 768-dimension vectors (see docs/adr/0006).
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Background indexing threads in the backend.
INGESTION_WORKERS=2
# Largest accepted upload.
MAX_UPLOAD_SIZE=25MB
# Chunk size for newly indexed documents, in estimated tokens (see docs/adr/0006). Overlap must be
# under half the chunk size. Already indexed documents keep their chunks until re-indexed.
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# Answers (Phase 2)
# LLM provider: "ollama" (local, default) or "anthropic" (hosted, opt-in). A hosted provider only
# receives documents whose hostedLlmAllowed setting is on (PATCH /api/documents/{id}).
LLM_PROVIDER=ollama
# Local chat model, chosen with eval/bench_local_llm.py (see eval/README.md).
OLLAMA_CHAT_MODEL=qwen3.5:2b-q4_K_M
# Set to false to skip downloading the chat model (retrieval-only setups such as CI).
PULL_CHAT_MODEL=true
# Only needed for LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# low, medium or high
ANTHROPIC_EFFORT=medium
# Port for Ollama on 127.0.0.1 (change if a native Ollama already uses 11434).
OLLAMA_PORT=11434
# Requests Ollama computes concurrently. 4 didn't help on CPU only (docs/performance.md).
OLLAMA_NUM_PARALLEL=1

# Optional reranker sidecar: run `docker compose --profile rerank up` and set RERANK_ENABLED=true.
RERANK_ENABLED=false
RERANKER_URL=http://reranker:8001
RERANKER_PORT=8001
RERANK_CANDIDATES=30

# Optional speech-to-text for voice commands (sidecars/whisper, runs locally): run
# `docker compose --profile voice up -d whisper` and set STT_PROVIDER=whisper. "none" turns voice off.
STT_PROVIDER=none
WHISPER_URL=http://whisper:8002
WHISPER_PORT=8002

# Resilience and load testing (Phase 4, docs/adr/0011)
# Per-user rate limits: capacity = burst, *_PER_MINUTE = sustained rate.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERY_CAPACITY=20
RATE_LIMIT_QUERY_PER_MINUTE=30
RATE_LIMIT_SEARCH_CAPACITY=60
RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_UPLOAD_CAPACITY=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
# LLM_PROVIDER=stub is for load tests only: a fake LLM that answers after this delay.
STUB_LLM_LATENCY=PT0.2S
# Estimated USD per million tokens for the hosted LLM cost metric (an estimate, not a bill).
ANTHROPIC_INPUT_USD_PER_MTOK=0.10
ANTHROPIC_OUTPUT_USD_PER_MTOK=0.50

# Observability (Phase 4)
# JSON logs (logstash format). Empty gives plain text.
LOG_FORMAT=logstash
TRACING_EXPORT_ENABLED=true
# Share of requests traced (1.0 = all).
TRACING_SAMPLING=1.0
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
# Grafana admin login (dashboards are viewable without it). Generate one; never commit it.
GRAFANA_ADMIN_PASSWORD=

# Claude Code notifications (Phase 10). Read by the desktop app, and by the hook commands in
# ~/.claude/settings.json, so set both as user environment variables (see docs/claude-code-hooks.md).
# At least 16 characters. Generate one; never commit it.
SMOI_HOOK_SECRET=
# Port of the local listener on 127.0.0.1 (default 47821).
SMOI_HOOK_PORT=47821

# Google Calendar and Gmail (Phase 8, docs/adr/0017 and 0018). Optional: without these the rest of
# SMOI works and Google features say "not configured". Create an OAuth client (type: Web
# application) in the Google Cloud console, enable the Gmail and Calendar APIs, and add the
# redirect URI below to its authorised redirect URIs. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64 AES-256 key (32 bytes) that encrypts refresh tokens at rest. Generate one, for example:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
GOOGLE_TOKEN_KEY=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/google/callback
